{
  "id": "./",
  "name": "UCCHR Biometric Attendance & Payroll System",
  "short_name": "UCCHR",
  "description": "Secure employee records, biometric attendance, schedules, overtime, payroll, payslips, and employee self-service for Ubay Community College.",
  "lang": "en-PH",
  "dir": "ltr",
  "start_url": "./launch.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6f1f2",
  "theme_color": "#8d1530",
